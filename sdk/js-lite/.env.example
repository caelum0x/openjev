# OpenJev / TypeSafe (System One / Jev) API key.
# The client checks OPENJEV_API_KEY first, then TYPESAFE_API_KEY, then typesafe_api_key.
OPENJEV_API_KEY=ots_live_your-key-here
# TYPESAFE_API_KEY=sk-your-key-here

# Optional overrides (OPENJEV_* aliases take precedence over TYPESAFE_*)
# OPENJEV_BASE_URL=http://localhost:8080/api/v1   # your self-hosted OpenJev
# TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
# TYPESAFE_MODEL=jev-latest
